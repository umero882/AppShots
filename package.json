{
  "name": "appshots",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AppShots \u2014 create App Store & Google Play screenshots in minutes",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "start": "node server/index.js",
    "serve": "npm run build && node server/index.js",
    "stripe:setup": "node --env-file=.env.local scripts/stripe/setup.mjs",
    "og:image": "node scripts/og/make-og-image.mjs",
    "uptime": "node scripts/ops/uptime-check.mjs",
    "coolify:env": "node --env-file=.env.local scripts/ops/coolify-set-env.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "rules:check": "firebase deploy --only firestore:rules --project appshots-76a56 --dry-run",
    "rules:deploy": "firebase deploy --only firestore:rules --project appshots-76a56",
    "waitlist": "node server/waitlist-cli.js list",
    "waitlist:export": "node server/waitlist-cli.js export",
    "waitlist:announce": "node server/waitlist-cli.js announce",
    "backup": "node server/backup-cli.js backup",
    "backup:list": "node server/backup-cli.js list",
    "backup:check": "node server/backup-cli.js check",
    "backup:test-alert": "node server/backup-cli.js test-alert",
    "backup:restore": "node server/backup-cli.js restore"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@supabase/supabase-js": "^2.108.2",
    "firebase": "^12.16.0",
    "framer-motion": "^10.16.4",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.292.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.16",
    "marked": "^12.0.2",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
